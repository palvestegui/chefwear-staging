rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and pre-provisioned account rules
    match /users/{userId} {
      // An authenticated user is permitted to read if:
      // - It is their own document (request.auth.uid == userId)
      // - OR resource.data.email == request.auth.token.email (for pre-provisioned query/lookup)
      // - OR superadmin / administrator
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.email == request.auth.token.email ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN']
      );

      // Create: user can create their own document where request.auth.uid == userId and request.resource.data.email == request.auth.token.email,
      // or superadmin / administrator pre-provisioning accounts
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.email == request.auth.token.email) ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageRoles == true
      );

      // Update: user updating their own document, or administrator
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageRoles == true
      );

      // Delete: permitted if resource.data.email == request.auth.token.email (for temporary pre-provisioned doc migration),
      // or administrator
      allow delete: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        request.auth.uid == userId ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN']
      );
    }

    // Allow public read and server synchronization for pricing & catalog documents
    match /pricing/{docId} {
      allow read, write: if true;
    }

    // Default permissions for all other application collections (orders, clientAccounts, masterContacts, settings, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

