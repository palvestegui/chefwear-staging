rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and pre-provisioned account rules (PRESERVED IN FULL)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.email == request.auth.token.email ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN']
      );

      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.email == request.auth.token.email) ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageRoles == true
      );

      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageRoles == true
      );

      allow delete: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        request.auth.uid == userId ||
        request.auth.token.email == 'palvestegui@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPERADMIN', 'ADMIN']
      );
    }

    // Pricing & Catalog documents (already open)
    match /pricing/{docId} {
      allow read, write: if true;
    }

    // Staging CRM & Operations Collections (Unblocks testing while Google OAuth is shelved)
    match /clientAccounts/{docId} {
      allow read, write: if true;
    }
    match /masterContacts/{docId} {
      allow read, write: if true;
    }
    match /account_contacts/{docId} {
      allow read, write: if true;
    }
    match /orders/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Default lockdown fallback for anything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}